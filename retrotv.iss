; Script generated by the Inno Setup Script Wizard.
#define MyAppName "RetroTV"
#define MyAppVersion "2.2.3"
#define MyAppPublisher "N5 Networks"
#define MyAppURL "https://retrotv.n5net.com"
#define MyAppExeName "RetroTV.exe"
#define MyAppAssocName MyAppName + " File"
#define MyAppAssocExt ".myp"
#define MyAppAssocKey StringChange(MyAppAssocName, " ", "") + MyAppAssocExt

[Setup]
AppId={{1031FF30-DD70-4C45-929D-454E3E14ED14}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName=C:\RetroTV
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
ChangesAssociations=yes
DisableProgramGroupPage=yes
LicenseFile=J:\py-git\gpl-2.0.txt
PrivilegesRequiredOverridesAllowed=dialog
OutputBaseFilename=retrotv_setup
Compression=lzma
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "commercialpack"; Description: "Download a pack of over 100 commercials for Channel Guide && Local Channels (recommended approx 2gb)"; GroupDescription: "Optional Content:"; Flags: unchecked

[Files]
Source: "J:\py-git\shafe-tv\dist\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "J:\py-git\shafe-tv\dist\ffmpeg.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "J:\py-git\shafe-tv\dist\ffplay.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "J:\py-git\shafe-tv\dist\ffprobe.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "J:\py-git\shafe-tv\guide.mp3"; DestDir: "{app}"; Flags: ignoreversion
Source: "J:\py-git\shafe-tv\retrotv.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: "J:\py-git\shafe-tv\retrotv.png"; DestDir: "{app}"; Flags: ignoreversion

[Registry]
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocExt}\OpenWithProgids"; ValueType: string; ValueName: "{#MyAppAssocKey}"; ValueData: ""; Flags: uninsdeletevalue
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}"; ValueType: string; ValueName: ""; ValueData: "{#MyAppAssocName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#MyAppExeName},0"
Root: HKA; Subkey: "Software\Classes\{#MyAppAssocKey}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#MyAppExeName}"" ""%1"""
Root: HKA; Subkey: "Software\Classes\Applications\{#MyAppExeName}\SupportedTypes"; ValueType: string; ValueName: ".myp"; ValueData: ""

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
var
  DownloadPage: TDownloadWizardPage;
  VLCPage: TWizardPage;

procedure OpenVLCPage(Sender: TObject);
var
  ErrCode: Integer;
begin
  ShellExec('open', 'https://www.videolan.org/vlc/', '', '', SW_SHOWNORMAL, ewNoWait, ErrCode);
end;

{ Returns True if a 64-bit VLC (libvlc.dll) is installed. RetroTV is a 64-bit
  app, so a 32-bit VLC does not count (python-vlc can't load it). Re-evaluated
  on each call so it picks up a VLC installed while this wizard is open. }
function VLCInstalled: Boolean;
var
  Dir: String;
begin
  Result := False;
  { Installer-written registry key (64-bit view), machine-wide then per-user }
  if RegQueryStringValue(HKLM64, 'SOFTWARE\VideoLAN\VLC', 'InstallDir', Dir) or
     RegQueryStringValue(HKCU64, 'SOFTWARE\VideoLAN\VLC', 'InstallDir', Dir) then
    if FileExists(AddBackslash(Dir) + 'libvlc.dll') then
    begin
      Result := True;
      Exit;
    end;
  { Fallback: default 64-bit Program Files location (also covers portable/zip installs) }
  Result := FileExists(ExpandConstant('{commonpf64}\VideoLAN\VLC\libvlc.dll'));
end;

function VLC32BitOnly: Boolean;
var
  Dir: String;
begin
  Result := (not VLCInstalled) and
            (RegQueryStringValue(HKLM32, 'SOFTWARE\VideoLAN\VLC', 'InstallDir', Dir) or
             FileExists(ExpandConstant('{commonpf32}\VideoLAN\VLC\libvlc.dll')));
end;

{ Skip the VLC notice entirely when VLC is already present }
function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := (VLCPage <> nil) and (PageID = VLCPage.ID) and VLCInstalled;
end;

{ If VLC is still missing when the user clicks Next, confirm before continuing }
function NextButtonClick(CurPageID: Integer): Boolean;
begin
  Result := True;
  if (VLCPage <> nil) and (CurPageID = VLCPage.ID) and (not VLCInstalled) then
    Result := MsgBox('VLC Media Player (64-bit) was not detected.' + #13#10#13#10 +
                     'RetroTV will not play TV channels until VLC is installed.' + #13#10#13#10 +
                     'Continue installing RetroTV anyway?',
                     mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES;
end;

procedure InitializeWizard;
var
  VLCLabel: TLabel;
  VLCButton: TButton;
begin
  { --- VLC requirement notice page (shown right after Welcome) --- }
  VLCPage := CreateCustomPage(wpWelcome,
    'VLC Player Required',
    'VLC Media Player is required for the TV (live streaming) feature');

  VLCLabel := TLabel.Create(VLCPage);
  VLCLabel.Parent   := VLCPage.Surface;
  VLCLabel.Caption  :=
    'VLC Media Player (64-bit) was not detected on this computer.' + #13#10#13#10 +
    'RetroTV''s TV feature requires VLC Media Player. VLC is free, open-source software. ' +
    'Click the button below to open the VLC download page. You may install VLC first and then ' +
    'click Next here (it will be detected automatically), or continue now and install VLC later.' + #13#10#13#10 +
    'Note: RetroTV will not operate without VLC installed.';
  if VLC32BitOnly then
    VLCLabel.Caption := VLCLabel.Caption + #13#10#13#10 +
      'A 32-bit VLC was found, but RetroTV needs the 64-bit version of VLC.';
  VLCLabel.Left     := 0;
  VLCLabel.Top      := 0;
  VLCLabel.Width    := VLCPage.SurfaceWidth;
  VLCLabel.WordWrap := True;
  VLCLabel.AutoSize := True;

  VLCButton := TButton.Create(VLCPage);
  VLCButton.Parent   := VLCPage.Surface;
  VLCButton.Caption  := 'Open VLC Download Page';
  VLCButton.Left     := 0;
  VLCButton.Top      := VLCLabel.Top + VLCLabel.Height + 20;
  VLCButton.Width    := 210;
  VLCButton.Height   := 30;
  VLCButton.OnClick  := @OpenVLCPage;

  { --- Commercial Pack download page --- }
  DownloadPage := CreateDownloadPage(
    'Downloading Commercial Pack',
    'Please wait while the Commercial Pack is downloaded...',
    nil);
end;

procedure DownloadAndInstallCommercials;
var
  ZipPath:    String;
  DestDir:    String;
  ResultCode: Integer;
begin
  ZipPath := ExpandConstant('{tmp}\commercials.zip');
  DestDir  := ExpandConstant('{app}\commercials');

  DownloadPage.Clear;
  DownloadPage.Add(
    'https://cdn.wedovids.com/tv/commercials.zip',
    'commercials.zip',
    '');

  DownloadPage.Show;
  try
    DownloadPage.Download;
  finally
    DownloadPage.Hide;
  end;

  if not FileExists(ZipPath) then
  begin
    MsgBox('Download failed: commercials.zip was not found after download.',
           mbError, MB_OK);
    Exit;
  end;

  if not DirExists(DestDir) then
    ForceDirectories(DestDir);

  if not Exec(
    ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'),
    '-NoProfile -NonInteractive -Command "Expand-Archive -LiteralPath ''' + ZipPath + ''' -DestinationPath ''' + DestDir + ''' -Force"',
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode)
  or (ResultCode <> 0) then
  begin
    MsgBox('Unzip failed (code ' + IntToStr(ResultCode) + '). The ZIP file has been left at:' + #13#10 + ZipPath,
           mbError, MB_OK);
    Exit;
  end;

  DeleteFile(ZipPath);
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
  begin
      if WizardIsTaskSelected('commercialpack') then
      DownloadAndInstallCommercials;
  end;
end;